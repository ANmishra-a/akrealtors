---
export const prerender = true;
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  title="Insights"
  description="Written from site visits and RERA filings, not from Google — AK Realtors' notes on East Pune's property market."
>
  <main class="container insights-index">
    <div class="mono-breadcrumb">akarohanrealtors.com / insights</div>
    <h1>Insights</h1>
    <p class="lede">
      Only what someone who visits sites weekly can write. No "home buying process in India" — that page is written
      a thousand times and answered by an AI summary before anyone clicks.
    </p>
    <div class="article-grid">
      {
        articles.map((a) => (
          <a href={`/insights/${a.id}/`} class="article-card">
            <div class="kicker">{a.data.kicker}</div>
            <h2>{a.data.title}</h2>
            <p class="text-muted">{a.data.dek}</p>
            <div class="byline mono-cell">
              {a.data.author.toUpperCase()} ·{" "}
              {a.data.publishDate.toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase()}
            </div>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .insights-index {
    padding: 56px 24px 96px;
  }
  .mono-breadcrumb {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--color-neutral-600);
    margin-bottom: 26px;
  }
  h1 {
    font-size: 58px;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }
  .lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-neutral-800);
    max-width: 640px;
    margin: 0 0 44px;
  }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-divider);
    border: 1px solid var(--color-divider);
  }
  .article-card {
    background: var(--color-bg);
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--color-ink);
  }
  .article-card:hover {
    text-decoration: none;
    background: var(--color-surface);
  }
  .article-card h2 {
    font-size: 30px;
    line-height: 1.08;
    margin: 0;
  }
  .article-card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }
  .byline {
    margin-top: auto;
    padding-top: 14px;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-neutral-600);
  }
  @media (max-width: 700px) {
    .article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
