---
/**
 * Facade-pattern YouTube embed: renders only the thumbnail + play button
 * until clicked, so a page with a walkthrough video doesn't pay for
 * YouTube's ~1MB iframe/JS on first load. See
 * docs/decisions/0009-media-hosting-imagekit-youtube.md.
 */
interface Props {
  videoId: string;
  title: string;
  ratio?: string;
}
const { videoId, title, ratio = "16/9" } = Astro.props;
---

<div class="yt-lite" style={`aspect-ratio:${ratio}`} data-yt-id={videoId} data-yt-title={title} role="button" tabindex="0">
  <img
    src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
    alt={title}
    loading="lazy"
    decoding="async"
  />
  <span class="yt-play" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7-11-7z" fill="currentColor"/></svg>
  </span>
</div>

<style>
  .yt-lite {
    position: relative;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-divider);
    background: var(--color-ink-strong);
    cursor: pointer;
  }
  .yt-lite img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .yt-lite iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: var(--color-ink);
    border-radius: 50%;
    padding-left: 3px;
  }
</style>

<script>
  for (const el of document.querySelectorAll<HTMLElement>(".yt-lite")) {
    const load = () => {
      const id = el.dataset.ytId;
      const title = el.dataset.ytTitle ?? "";
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.title = title;
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    };
    el.addEventListener("click", load, { once: true });
    el.addEventListener(
      "keydown",
      (e) => {
        if (e instanceof KeyboardEvent && (e.key === "Enter" || e.key === " ")) {
          e.preventDefault();
          load();
        }
      },
      { once: true }
    );
  }
</script>
