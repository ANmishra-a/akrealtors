# Copy to .env for local dev (astro dev reads this automatically).
# In production these are set as Cloudflare Pages build-time environment
# variables (Settings → Environment variables) — PUBLIC_* vars are safe
# to expose since they end up in client-side JS regardless.

# ImageKit CDN endpoint for property photos — see
# docs/decisions/0009-media-hosting-imagekit-youtube.md
PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/akrealtors

# Analytics — leave blank to ship with zero tracking until you have IDs.
# See docs/decisions/0011-analytics-consent.md
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# --- Cloudflare-only bindings (NOT read from .env — set these via
# wrangler secret / the Pages dashboard, see wrangler.toml comments) ---
# TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID
# LEADS_KV (KV namespace binding)
# RATE_LIMIT_KV (KV namespace binding)
